# Example only; export through your shell. Do not commit real secret values.
JWT_SECRET_KEY=replace-with-long-cryptographically-random-string
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-with-random-encryption-primary-key
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-with-different-random-encryption-key
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-random-encryption-salt
DEMO_ADMIN_PASSWORD=replace-with-development-only-password
DEMO_CLIENT_PASSWORD=replace-with-another-development-only-password
# PostgreSQL: configure config/database.yml, PGUSER/PGHOST, or DATABASE_URL.

# Opt-in diagnostic fields (exception class/message/15-frame trace) on API errors.
# Default: false. Works only in development/test; ignored in production.
# WARNING: debug details may disclose internals; never enable for public demos.
WOGI_SHOW_EXCEPTION_DETAILS=false
